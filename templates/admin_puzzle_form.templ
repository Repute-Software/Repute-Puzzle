package templates

import "puzzle/models"
import "fmt"

templ AdminPuzzleFormCreate(companyName string, userEmail string, errorMsg string) {
	@AdminLayout("Create Puzzle", companyName, userEmail) {
		@PuzzleForm(nil, errorMsg, false)
	}
}

templ AdminPuzzleFormEdit(companyName string, userEmail string, puzzle *models.Puzzle, errorMsg string) {
	@AdminLayout("Edit Puzzle", companyName, userEmail) {
		@PuzzleForm(puzzle, errorMsg, true)
	}
}

templ PuzzleForm(puzzle *models.Puzzle, errorMsg string, isEdit bool) {
	<div class="page-header">
		<h2 class="page-title">
			if isEdit {
				Edit Puzzle
			} else {
				Create New Puzzle
			}
		</h2>
		<p class="page-subtitle">Configure your interactive puzzle settings</p>
	</div>
	
	<style>
		.form-container {
			background: white;
			border-radius: 12px;
			padding: 40px;
			box-shadow: 0 2px 8px rgba(0,0,0,0.1);
			max-width: 800px;
		}
		.error {
			background: #fee;
			border: 1px solid #fcc;
			color: #c33;
			padding: 12px;
			border-radius: 6px;
			margin-bottom: 20px;
			font-size: 14px;
		}
		.form-group {
			margin-bottom: 24px;
		}
		label {
			display: block;
			margin-bottom: 8px;
			color: #333;
			font-weight: 600;
			font-size: 14px;
		}
		.label-hint {
			font-weight: 400;
			color: #999;
			font-size: 13px;
			margin-left: 8px;
		}
		input[type="text"],
		input[type="number"],
		input[type="file"],
		select {
			width: 100%;
			padding: 12px;
			border: 2px solid #e0e0e0;
			border-radius: 6px;
			font-size: 14px;
			transition: border-color 0.3s;
		}
		input[type="text"]:focus,
		input[type="number"]:focus,
		select:focus {
			outline: none;
			border-color: #667eea;
		}
		.form-row {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 20px;
		}
		.hint {
			font-size: 13px;
			color: #666;
			margin-top: 6px;
		}
		.checkbox-group {
			display: flex;
			align-items: center;
			gap: 10px;
		}
		input[type="checkbox"] {
			width: 20px;
			height: 20px;
			cursor: pointer;
		}
		.form-actions {
			display: flex;
			gap: 12px;
			margin-top: 30px;
			padding-top: 30px;
			border-top: 1px solid #e0e0e0;
		}
		.btn {
			padding: 12px 24px;
			border-radius: 8px;
			font-size: 16px;
			font-weight: 600;
			cursor: pointer;
			border: none;
			transition: transform 0.2s, box-shadow 0.2s;
		}
		.btn-primary {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: white;
		}
		.btn-primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
		}
		.btn-secondary {
			background: #f5f5f5;
			color: #666;
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}
		.btn-secondary:hover {
			background: #e0e0e0;
		}
		.image-preview {
			margin-top: 10px;
			max-width: 200px;
			border-radius: 8px;
			border: 2px solid #e0e0e0;
		}
		.form-section {
			margin: 40px 0;
			padding: 30px;
			background: #f8f9fa;
			border-radius: 12px;
			border: 1px solid #e0e0e0;
		}
		.section-title {
			color: #333;
			font-size: 1.3rem;
			font-weight: 600;
			margin-bottom: 8px;
		}
		.section-subtitle {
			color: #666;
			font-size: 14px;
			margin-bottom: 25px;
		}
		.color-input-group {
			display: flex;
			gap: 10px;
			align-items: center;
		}
		.color-input-group input[type="color"] {
			width: 50px;
			height: 40px;
			border: 2px solid #e0e0e0;
			border-radius: 6px;
			cursor: pointer;
			padding: 0;
		}
		.color-input-group input[type="text"] {
			flex: 1;
			font-family: 'Courier New', monospace;
		}
		.theme-editor-container {
			display: flex;
			gap: 30px;
			align-items: flex-start;
		}
		.color-controls {
			flex: 1;
		}
		.color-preview {
			flex: 1;
			min-width: 300px;
		}
		.preview-box {
			background: white;
			border: 2px solid #e0e0e0;
			border-radius: 12px;
			padding: 20px;
			text-align: center;
		}
		.preview-puzzle-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 2px;
			background: #333333;
			padding: 2px;
			border-radius: 8px;
			margin: 0 auto 15px;
			width: 150px;
			aspect-ratio: 1;
		}
		.preview-tile {
			background: #667eea;
			border-radius: 4px;
			aspect-ratio: 1;
			transition: background-color 0.2s;
		}
		.preview-tile:hover {
			background: #5568d3;
		}
		.preview-buttons {
			display: flex;
			gap: 10px;
			justify-content: center;
		}
		.preview-btn {
			padding: 8px 16px;
			border: none;
			border-radius: 6px;
			font-size: 14px;
			font-weight: 600;
			cursor: pointer;
			transition: transform 0.2s;
		}
		.preview-btn:hover {
			transform: translateY(-1px);
		}
		.preview-btn-primary {
			background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			color: #ffffff;
		}
		.preview-btn-secondary {
			background: #f5f5f5;
			color: #666;
		}
		@media (max-width: 768px) {
			.theme-editor-container {
				flex-direction: column;
				gap: 20px;
			}
			.color-preview {
				min-width: auto;
			}
		}
	</style>
	
	<div class="form-container">
		if errorMsg != "" {
			<div class="error">{ errorMsg }</div>
		}
		
		if isEdit {
			<form method="POST" action={ templ.URL(fmt.Sprintf("/admin/puzzles/%d", puzzle.ID)) } enctype="multipart/form-data">
				@PuzzleFormFields(puzzle, isEdit)
			</form>
		} else {
			<form method="POST" action="/admin/puzzles" enctype="multipart/form-data">
				@PuzzleFormFields(puzzle, isEdit)
			</form>
		}
	</div>
}

templ PuzzleFormFields(puzzle *models.Puzzle, isEdit bool) {
	<div class="form-group">
		<label for="name">
			Puzzle Name
			<span class="label-hint">A friendly name for your puzzle</span>
		</label>
		if puzzle != nil {
			<input type="text" id="name" name="name" required value={ puzzle.Name } placeholder="Summer Sale 2025"/>
		} else {
			<input type="text" id="name" name="name" required placeholder="Summer Sale 2025"/>
		}
	</div>
	
	<div class="form-group">
		<label for="slug">
			URL Slug
			<span class="label-hint">Used in puzzle URL</span>
		</label>
		if puzzle != nil {
			<input type="text" id="slug" name="slug" required value={ puzzle.Slug } placeholder="summer-sale-2025" pattern="[a-z0-9-]+"/>
		} else {
			<input type="text" id="slug" name="slug" required placeholder="summer-sale-2025" pattern="[a-z0-9-]+"/>
		}
		<div class="hint">Only lowercase letters, numbers, and hyphens</div>
	</div>
	
	<div class="form-group">
		<label for="image">
			Puzzle Image
			<span class="label-hint">PNG format recommended</span>
		</label>
		<input 
			type="file" 
			id="image" 
			name="image" 
			accept="image/png,image/jpeg,image/jpg"
			if !isEdit {
				required
			}
		/>
		if isEdit && puzzle != nil && puzzle.ImagePath != "" {
			<img src={ puzzle.ImagePath } alt="Current image" class="image-preview"/>
			<div class="hint">Leave empty to keep current image</div>
		}
	</div>
	
	<div class="form-row">
		<div class="form-group">
			<label for="grid_size">Grid Size</label>
			<select id="grid_size" name="grid_size" required>
				<option value="3" selected?={ puzzle == nil || puzzle.GridSize == 3 }>3x3 (Easy)</option>
				<option value="4" selected?={ puzzle != nil && puzzle.GridSize == 4 }>4x4 (Medium)</option>
				<option value="5" selected?={ puzzle != nil && puzzle.GridSize == 5 }>5x5 (Hard)</option>
			</select>
		</div>
		
		<div class="form-group">
			<label for="discount_percent">Discount %</label>
			if puzzle != nil {
				<input type="number" id="discount_percent" name="discount_percent" required min="0" max="100" value={ fmt.Sprintf("%d", puzzle.DiscountPercent) }/>
			} else {
				<input type="number" id="discount_percent" name="discount_percent" required min="0" max="100" value="15"/>
			}
		</div>
	</div>
	
	<div class="form-row">
		<div class="form-group">
			<label for="time_limit">Time Limit (seconds)</label>
			if puzzle != nil {
				<input type="number" id="time_limit" name="time_limit" required min="0" value={ fmt.Sprintf("%d", puzzle.TimeLimit) }/>
			} else {
				<input type="number" id="time_limit" name="time_limit" required min="0" value="90"/>
			}
			<div class="hint">0 = no time limit</div>
		</div>
		
		<div class="form-group">
			<label for="timer_mode">Timer Mode</label>
			<select id="timer_mode" name="timer_mode" required>
				<option value="immediate" selected?={ puzzle == nil || puzzle.TimerMode == "immediate" }>Start Immediately</option>
				<option value="first_move" selected?={ puzzle != nil && puzzle.TimerMode == "first_move" }>Start on First Move</option>
				<option value="countdown" selected?={ puzzle != nil && puzzle.TimerMode == "countdown" }>Countdown</option>
			</select>
		</div>
	</div>
	
	<div class="form-row">
		<div class="form-group">
			<label for="scramble_moves">Scramble Moves</label>
			if puzzle != nil {
				<input type="number" id="scramble_moves" name="scramble_moves" required min="5" max="100" value={ fmt.Sprintf("%d", puzzle.ScrambleMoves) }/>
			} else {
				<input type="number" id="scramble_moves" name="scramble_moves" required min="5" max="100" value="25"/>
			}
			<div class="hint">Number of random moves</div>
		</div>
		
		<div class="form-group">
			<label for="auto_solve_speed">Auto-Solve Speed (ms)</label>
			if puzzle != nil {
				<input type="number" id="auto_solve_speed" name="auto_solve_speed" required min="10" max="1000" value={ fmt.Sprintf("%d", puzzle.AutoSolveSpeed) }/>
			} else {
				<input type="number" id="auto_solve_speed" name="auto_solve_speed" required min="10" max="1000" value="50"/>
			}
		</div>
	</div>
	
	<div class="form-group">
		<label for="code_expiration_days">Code Expiration (days)</label>
		if puzzle != nil {
			<input type="number" id="code_expiration_days" name="code_expiration_days" min="0" value={ fmt.Sprintf("%d", puzzle.CodeExpirationDays) }/>
		} else {
			<input type="number" id="code_expiration_days" name="code_expiration_days" min="0" value="0"/>
		}
		<div class="hint">0 = codes never expire</div>
	</div>
	
	<div class="form-group">
		<div class="checkbox-group">
			<input 
				type="checkbox" 
				id="testing_mode" 
				name="testing_mode" 
				value="true"
				checked?={ puzzle != nil && puzzle.TestingMode }
			/>
			<label for="testing_mode" style="margin-bottom: 0;">Enable Testing Mode (shows auto-solve button)</label>
		</div>
	</div>
	
	<div class="form-group">
		<div class="checkbox-group">
			<input 
				type="checkbox" 
				id="is_active" 
				name="is_active" 
				value="true"
				checked?={ puzzle == nil || puzzle.IsActive }
			/>
			<label for="is_active" style="margin-bottom: 0;">Active (visible to users)</label>
		</div>
	</div>
	
	<!-- Theme Customization Section -->
	<div class="form-section">
		<h3 class="section-title">Theme Customization</h3>
		<p class="section-subtitle">Customize the colors for your puzzle theme</p>
		
		<div class="theme-editor-container">
			<div class="color-controls">
				<div class="form-row">
			<div class="form-group">
				<label for="tile_color">
					Tile Color
					<span class="label-hint">Main puzzle tile color</span>
				</label>
				<div class="color-input-group">
					if puzzle != nil && puzzle.TileColor != "" {
						<input type="color" id="tile_color" name="tile_color" value={ puzzle.TileColor }/>
					} else {
						<input type="color" id="tile_color" name="tile_color" value="#667eea"/>
					}
					<input type="text" id="tile_color_hex" placeholder="#667eea" pattern="^#[0-9A-Fa-f]{6}$" title="Enter a valid hex color code"/>
				</div>
			</div>
			
			<div class="form-group">
				<label for="tile_hover_color">
					Tile Hover Color
					<span class="label-hint">Color when hovering over tiles</span>
				</label>
				<div class="color-input-group">
					if puzzle != nil && puzzle.TileHoverColor != "" {
						<input type="color" id="tile_hover_color" name="tile_hover_color" value={ puzzle.TileHoverColor }/>
					} else {
						<input type="color" id="tile_hover_color" name="tile_hover_color" value="#5568d3"/>
					}
					<input type="text" id="tile_hover_color_hex" placeholder="#5568d3" pattern="^#[0-9A-Fa-f]{6}$" title="Enter a valid hex color code"/>
				</div>
			</div>
		</div>
		
		<div class="form-row">
			<div class="form-group">
				<label for="background_color">
					Background Color
					<span class="label-hint">Page background color or gradient</span>
				</label>
				<div class="color-input-group">
					if puzzle != nil && puzzle.BackgroundColor != "" {
						<input type="color" id="background_color" name="background_color" value="#667eea"/>
					} else {
						<input type="color" id="background_color" name="background_color" value="#667eea"/>
					}
					<input type="text" id="background_color_hex" placeholder="linear-gradient(135deg, #667eea 0%, #764ba2 100%)" title="Enter a color or CSS gradient"/>
				</div>
			</div>
			
			<div class="form-group">
				<label for="text_color">
					Text Color
					<span class="label-hint">Main text color</span>
				</label>
				<div class="color-input-group">
					if puzzle != nil && puzzle.TextColor != "" {
						<input type="color" id="text_color" name="text_color" value={ puzzle.TextColor }/>
					} else {
						<input type="color" id="text_color" name="text_color" value="#333333"/>
					}
					<input type="text" id="text_color_hex" placeholder="#333333" pattern="^#[0-9A-Fa-f]{6}$" title="Enter a valid hex color code"/>
				</div>
			</div>
		</div>
		
		<div class="form-row">
			<div class="form-group">
				<label for="button_text_color">
					Button Text Color
					<span class="label-hint">Text color for buttons</span>
				</label>
				<div class="color-input-group">
					if puzzle != nil && puzzle.ButtonTextColor != "" {
						<input type="color" id="button_text_color" name="button_text_color" value={ puzzle.ButtonTextColor }/>
					} else {
						<input type="color" id="button_text_color" name="button_text_color" value="#ffffff"/>
					}
					<input type="text" id="button_text_color_hex" placeholder="#ffffff" pattern="^#[0-9A-Fa-f]{6}$" title="Enter a valid hex color code"/>
				</div>
			</div>
			
			<div class="form-group">
				<label for="border_color">
					Border Color
					<span class="label-hint">Border color for puzzle grid</span>
				</label>
				<div class="color-input-group">
					if puzzle != nil && puzzle.BorderColor != "" {
						<input type="color" id="border_color" name="border_color" value={ puzzle.BorderColor }/>
					} else {
						<input type="color" id="border_color" name="border_color" value="#333333"/>
					}
					<input type="text" id="border_color_hex" placeholder="#333333" pattern="^#[0-9A-Fa-f]{6}$" title="Enter a valid hex color code"/>
				</div>
			</div>
		</div>
		</div>
		
		<div class="color-preview">
			<h4 style="margin: 0 0 15px 0; color: #333; font-size: 1.1rem;">Live Preview</h4>
			<div class="preview-box" id="preview-box">
				<div class="preview-puzzle-grid">
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
					<div class="preview-tile"></div>
				</div>
				<div class="preview-buttons">
					<button type="button" class="preview-btn preview-btn-primary">Shuffle</button>
					<button type="button" class="preview-btn preview-btn-secondary">Hint</button>
				</div>
			</div>
		</div>
	</div>
	
	<div class="form-actions">
		<button type="submit" class="btn btn-primary">
			if isEdit {
				Save Changes
			} else {
				Create Puzzle
			}
		</button>
		<a href="/admin" class="btn btn-secondary">Cancel</a>
	</div>
	
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const previewBox = document.getElementById('preview-box');
			const colorInputs = [
				{ color: 'tile_color', hex: 'tile_color_hex', cssVar: '--primary-color' },
				{ color: 'tile_hover_color', hex: 'tile_hover_color_hex', cssVar: '--primary-hover' },
				{ color: 'background_color', hex: 'background_color_hex', cssVar: '--background-color' },
				{ color: 'text_color', hex: 'text_color_hex', cssVar: '--text-color' },
				{ color: 'button_text_color', hex: 'button_text_color_hex', cssVar: '--button-text-color' },
				{ color: 'border_color', hex: 'border_color_hex', cssVar: '--border-color' }
			];
			
			// Initialize preview with current values
			updatePreview();
			
			// Set up bidirectional sync and real-time updates
			colorInputs.forEach(input => {
				const colorPicker = document.getElementById(input.color);
				const hexInput = document.getElementById(input.hex);
				
				if (colorPicker && hexInput) {
					// Sync color picker to hex input
					colorPicker.addEventListener('input', function() {
						hexInput.value = this.value;
						updatePreview();
					});
					
					// Sync hex input to color picker
					hexInput.addEventListener('input', function() {
						if (this.value.match(/^#[0-9A-Fa-f]{6}$/)) {
							colorPicker.value = this.value;
							updatePreview();
						}
					});
					
					// Update preview on hex input blur (for gradients)
					hexInput.addEventListener('blur', function() {
						updatePreview();
					});
				}
			});
			
			function updatePreview() {
				// Get current color values
				const tileColor = document.getElementById('tile_color')?.value || '#667eea';
				const tileHoverColor = document.getElementById('tile_hover_color')?.value || '#5568d3';
				const backgroundColor = document.getElementById('background_color_hex')?.value || 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
				const textColor = document.getElementById('text_color')?.value || '#333333';
				const buttonTextColor = document.getElementById('button_text_color')?.value || '#ffffff';
				const borderColor = document.getElementById('border_color')?.value || '#333333';
				
				// Apply colors to preview
				previewBox.style.setProperty('--primary-color', tileColor);
				previewBox.style.setProperty('--primary-hover', tileHoverColor);
				previewBox.style.setProperty('--background-color', backgroundColor);
				previewBox.style.setProperty('--text-color', textColor);
				previewBox.style.setProperty('--button-text-color', buttonTextColor);
				previewBox.style.setProperty('--border-color', borderColor);
				
				// Apply background to preview box
				previewBox.style.background = backgroundColor;
				
				// Apply colors to preview tiles
				const previewTiles = previewBox.querySelectorAll('.preview-tile');
				previewTiles.forEach(tile => {
					tile.style.background = tileColor;
				});
				
				// Apply colors to preview grid border
				const previewGrid = previewBox.querySelector('.preview-puzzle-grid');
				if (previewGrid) {
					previewGrid.style.background = borderColor;
				}
				
				// Apply colors to preview buttons
				const primaryBtn = previewBox.querySelector('.preview-btn-primary');
				const secondaryBtn = previewBox.querySelector('.preview-btn-secondary');
				
				if (primaryBtn) {
					primaryBtn.style.background = `linear-gradient(135deg, ${tileColor} 0%, ${tileHoverColor} 100%)`;
					primaryBtn.style.color = buttonTextColor;
				}
				
				if (secondaryBtn) {
					secondaryBtn.style.color = textColor;
				}
			}
		});
	</script>
	</div>
}

package templates

import (
	"fmt"
	"puzzle/models"
)

templ Embed(gridSize int, imageURL string, timeLimit int, timerMode string, countdownTime int, testingMode bool, scrambleMoves int, autoSolveSpeed int, t *models.Translations, lang string, primaryColor string) {
	@Layout(t.Game.Title) {
		<div class="game-container embed-mode" data-embed="true" data-primary-color={ primaryColor }>
			<div class="game-stats">
				<div class="stat">
					<span class="stat-label">{ t.Game.Moves }:</span>
					<span id="move-count" class="stat-value">0</span>
				</div>
				if timeLimit > 0 {
					<div class="stat">
						<span class="stat-label">{ t.Game.Time }:</span>
						<span id="time-display" class="stat-value">{ fmt.Sprintf("%d:%02d", timeLimit/60, timeLimit%60) }</span>
					</div>
				}
			</div>

		<div id="puzzle-container" 
			 class="puzzle-grid" 
			 style={ fmt.Sprintf("grid-template-columns: repeat(%d, 1fr); grid-template-rows: repeat(%d, 1fr);", gridSize, gridSize) }
			 data-grid-size={ fmt.Sprintf("%d", gridSize) }
			 data-image-url={ imageURL }
			 data-time-limit={ fmt.Sprintf("%d", timeLimit) }
			 data-timer-mode={ timerMode }
			 data-countdown-time={ fmt.Sprintf("%d", countdownTime) }
			 data-testing-mode={ fmt.Sprintf("%t", testingMode) }
			 data-scramble-moves={ fmt.Sprintf("%d", scrambleMoves) }
			 data-auto-solve-speed={ fmt.Sprintf("%d", autoSolveSpeed) }>
			<!-- Tiles will be generated by JavaScript -->
		</div>

			<div class="game-controls">
				<button id="shuffle-btn" class="btn btn-primary">{ t.Game.NewPuzzle }</button>
				<button id="hint-btn" class="btn btn-secondary">{ t.Game.ShowSolution }</button>
				if testingMode {
					<button id="auto-solve-btn" class="btn btn-success" data-text-solve={ t.Game.AutoSolve } data-text-solving={ t.Game.Solving }>{ t.Game.AutoSolve }</button>
				}
			</div>
		</div>

		<!-- Success Modal -->
		<div id="success-modal" class="modal">
			<div class="modal-content">
				<h2>{ t.Modal.Congratulations }</h2>
				<p>{ t.Modal.Completed }</p>
				<p class="completion-stats">
					<span>{ t.Modal.MovesLabel }: <strong id="final-moves">0</strong></span>
					<span>{ t.Modal.TimeLabel }: <strong id="final-time">0:00</strong></span>
				</p>
				<form id="email-form" hx-post="/complete" hx-target="#email-form" hx-swap="outerHTML swap:500ms settle:500ms scroll:smooth">
					<div class="form-group">
						<label for="email">{ t.Modal.EmailPrompt }</label>
						<input type="email" id="email" name="email" required placeholder={ t.Modal.EmailPlaceholder }/>
					</div>
					<input type="hidden" id="moves-input" name="moves" value="0"/>
					<input type="hidden" id="time-input" name="time" value="0"/>
					<input type="hidden" name="lang" value={ lang }/>
					<button type="submit" class="btn btn-success">{ t.Modal.GetCodeButton }</button>
				</form>
			</div>
		</div>
		
		<!-- Pass translations to JavaScript -->
		<script type="text/javascript">
			window.translations = {
				game: {
					solving: { templ.JSONString(t.Game.Solving) }
				}
			};
		</script>
		
		<!-- Embed-specific JavaScript -->
		<script src="/static/embed.js"></script>
	}
}

